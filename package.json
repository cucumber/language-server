{
  "name": "@cucumber/language-server",
  "version": "1.7.0",
  "description": "Cucumber Language Server",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm/index.d.ts",
      "default": "./dist/wasm/index.js"
    }
  },
  "files": [
    "dist",
    "node",
    "wasm"
  ],
  "bin": {
    "cucumber-language-server": "bin/cucumber-language-server.js"
  },
  "scripts": {
    "build": "npm run build:version && tsc --project tsconfig.build.json",
    "build:version": "node --eval \"console.log('export const version = \\'' + require('./package.json').version + '\\'')\" > src/version.ts",
    "fix": "biome check --fix --error-on-warnings",
    "lint": "biome check --error-on-warnings",
    "postbuild": "node -e \"require('.')\"",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/cucumber/language-server.git"
  },
  "keywords": [
    "cucumber",
    "gherkin",
    "lsp"
  ],
  "author": "Cucumber Limited <cukes@googlegroups.com>",
  "contributors": [
    "Aslak Hellesøy <aslak.hellesoy@gmail.com>",
    "Aurélien Reeves <aurelien.reeves@smartbear.com>",
    "Binh Duc Tran <binhtran432k@gmail.com>",
    "Kieran Ryan <kierankilkenny@gmail.com>",
    "William Boman <william@redwill.se>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cucumber/language-server/issues"
  },
  "homepage": "https://github.com/cucumber/language-server#readme",
  "lint-staged": {
    "*": "biome check --fix --no-errors-on-unmatched --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cucumber/biome-config": "github:cucumber/biome-config#v0.6.0",
    "@cucumber/cucumber": "13.3.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "^17.0.0",
    "mocha": "12.0.3",
    "ts-node": "10.9.2",
    "typescript": "^6.0.3",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-protocol": "3.17.2"
  },
  "dependencies": {
    "@cucumber/gherkin-utils": "^12.0.0",
    "@cucumber/language-service": "^1.7.0",
    "fast-glob": "3.3.3",
    "source-map-support": "0.5.21",
    "vscode-languageserver": "8.0.2",
    "vscode-languageserver-textdocument": "1.0.16",
    "vscode-languageserver-types": "3.18.5"
  }
}
